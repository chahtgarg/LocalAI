
<?xml version="1.0" encoding="utf-8"?>

<!-- Root declaration of the Android application. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:label="LocalAI"
        android:supportsRtl="true"
        android:theme="@style/Theme.LocalAI">

        <!-- Main screen of the application. -->
        <activity
            android:name=".MainActivity"
            android:exported="true">

            <!-- Makes MainActivity the app's launcher screen. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Registers the custom accessibility service. -->
        <service
            android:name=".ScreenReaderService"

            <!-- Only Android's system can bind using this permission. -->
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"

            <!-- Prevents other apps from directly launching this component. -->
            android:exported="false">

            <!-- Identifies this component as an AccessibilityService. -->
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

        </service>

    </application>

</manifest>
